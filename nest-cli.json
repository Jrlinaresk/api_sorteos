{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "src/assets/img/*", "outDir": "dist/assets/img" },
      { "include": "src/templates/*", "outDir": "dist/templates" }
    ]
  }
}
