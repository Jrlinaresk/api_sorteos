{
  "name": "api_rest_sorteos",
  "version": "1.0.0",
  "description": "Backend transaccional para campañas de sorteos y checkout Pix",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:admin",
    "build:server": "nest build",
    "build:admin": "vite build --config admin/vite.config.mts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"admin/**/*.{ts,tsx,css,html,json}\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "concurrently --kill-others-on-fail --names api,admin --prefix-colors cyan,magenta \"pnpm start:dev:api\" \"pnpm start:dev:admin\"",
    "start:dev:api": "cross-env NODE_ENV=development nest start --watch",
    "start:dev:admin": "vite --config admin/vite.config.mts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "bootstrap:admin": "node dist/bootstrap-admin",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" \"admin/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" \"admin/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:admin": "vitest run --config admin/vitest.config.mts",
    "test:ci": "jest --runInBand --ci && pnpm test:admin",
    "verify": "pnpm lint:check && pnpm build && pnpm test:ci"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@tanstack/react-query": "5.102.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "country-state-city": "^3.2.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "lucide-react": "1.34.0",
    "mongoose": "^8.24.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "7.18.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.5",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/serve-static": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.28.0": "7.29.7",
      "ajv@6.12.6": "6.15.0",
      "brace-expansion@1.1.12": "1.1.18",
      "diff@4.0.2": "4.0.4",
      "fast-uri@3.0.6": "3.1.6",
      "flatted@3.3.3": "3.4.4",
      "js-yaml@3.14.1": "3.15.1",
      "js-yaml@4.1.0": "4.3.1",
      "minimatch@3.1.2": "3.1.5",
      "picomatch@2.3.1": "2.3.2",
      "ws": "8.21.3"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
