# Copie este archivo a .env.server con ./setup-env.sh y complete los campos vacíos.
# Nunca versionar .env.server, certificados ni valores secretos.

# Proceso HTTP
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
API_PORT=8017
HTTP_PORT=8081
TRUST_PROXY=true
CORS_ORIGINS=https://app.example.invalid
SWAGGER_ENABLED=false

# MongoDB: dos identidades distintas y un replica set para transacciones.
MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=sorteos_app
MONGO_APP_PASSWORD=
MONGO_DATABASE=api_sorteos
MONGO_REPLICA_SET=rs0
MONGO_REPLICA_KEY=
MONGO_PORT=27017
MONGODB_URI=
MONGODB_MAX_POOL_SIZE=30
MONGODB_AUTO_INDEX=true

# JWT y sesiones
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=api-sorteos
JWT_AUDIENCE=api-sorteos-clients
JWT_REFRESH_DAYS=30

# Correo. SMTP_USER y SMTP_PASS deben estar ambos presentes o ambos vacíos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_CODE_SECRET=

# Pedidos y acceso público acotado
ORDER_RESERVATION_MINUTES=15
CHECKOUT_ACCESS_SECRET_KEY=
ORDER_ACCESS_CODE_SECRET=
ORDER_ACCESS_MAX_ORDERS=20
ORDER_ACCESS_REQUEST_COOLDOWN_SECONDS=60

# Pagos Pix EFI
PAYMENTS_PROVIDER=efi
PAYMENTS_ALLOW_MOCK=false
PAYMENTS_PUBLIC_SECRET_KEY=
PAYMENTS_OUTBOX_MAX_ATTEMPTS=12
PAYMENTS_OUTBOX_LOCK_SECONDS=300
PAYMENTS_OUTBOX_BACKOFF_SECONDS=5
EFI_PIX_ENV=production
EFI_PIX_CLIENT_ID=
EFI_PIX_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_PIX_TIMEOUT_MS=15000
EFI_PIX_BASE_URL=
EFI_CERTS_DIR=./runtime/efi
EFI_PIX_CERTIFICATE_PATH=/run/secrets/efi/certificate.p12
EFI_PIX_CERT_PATH=
EFI_PIX_KEY_PATH=
EFI_PIX_CERTIFICATE_PASSPHRASE=
EFI_WEBHOOK_HMAC=
EFI_WEBHOOK_REQUIRE_MTLS=false
EFI_WEBHOOK_MTLS_HEADER=x-ssl-client-verify
EFI_WEBHOOK_MTLS_SUCCESS_VALUE=SUCCESS

# Resultado oficial Lotería Federal CAIXA. El host y la ruta son validados.
CAIXA_FEDERAL_API_BASE_URL=https://servicebus3.caixa.gov.br/portaldeloterias/api/federal
CAIXA_FEDERAL_TIMEOUT_MS=10000
CAIXA_FEDERAL_MAX_RESPONSE_BYTES=131072
CAIXA_FEDERAL_CONFIRMATION_DELAY_MS=250

# Métodos de sorteo alternativos. En producción permanecen apagados salvo
# habilitación explícita. El criptográfico obtiene entropía de NIST, nunca del operador.
DRAW_MANUAL_EXTERNAL_ENABLED=false
DRAW_CRYPTOGRAPHIC_ENABLED=false
DRAW_ENTROPY_BEACON_URL=https://beacon.nist.gov/beacon/2.0/pulse/last
DRAW_ENTROPY_BEACON_TIMEOUT_MS=10000
DRAW_ENTROPY_BEACON_MAX_RESPONSE_BYTES=262144

# Medios. Compose reemplaza estas rutas por el volumen y tmpfs del contenedor.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=/var/lib/api-sorteos/media
MEDIA_UPLOAD_TMP_DIR=/tmp/api-sorteos-media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=262144000

# Web Push. Deje las tres claves VAPID vacías para usar el proveedor no-op.
NOTIFICATION_PUSH_PROVIDER=noop
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_TIMEOUT_MS=10000
WEB_PUSH_URGENCY=normal
WEB_PUSH_MAX_PAYLOAD_BYTES=3500
WEB_PUSH_MAX_CONCURRENCY=10

# Referidos y rate limiting
REFERRAL_IP_HASH_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
